{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["name", "summary"]
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,15}$" },
          "title": { "type": "string" },
          "spec": { "type": "string" },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "agent": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
          "requirement_ids": { "type": "array", "items": { "type": "string" } },
          "contract_ids": { "type": "array", "items": { "type": "string" } },
          "program_element_ids": { "type": "array", "items": { "type": "string" } },
          "qa_evidence": { "type": "array", "items": { "type": "string" } },
          "file_ownership": { "type": "array", "items": { "type": "string" } },
          "vertical_outcome": { "type": "string" }
        },
        "required": ["key", "title", "spec", "acceptance_criteria", "dependencies", "agent", "requirement_ids", "contract_ids", "program_element_ids", "qa_evidence", "file_ownership", "vertical_outcome"]
      }
    }
  },
  "required": ["project", "open_questions", "tickets"]
}
