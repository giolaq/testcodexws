{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "summary": {"type": "string"}
      },
      "required": ["name", "summary"]
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "title": {"type": "string"},
          "spec": {"type": "string"},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "agent": {"type": "string", "enum": ["claude", "codex", "cursor"]}
        },
        "required": ["key", "title", "spec", "acceptance_criteria", "dependencies", "agent"]
      }
    }
  },
  "required": ["project", "open_questions", "tickets"]
}
